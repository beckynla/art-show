# Database
# For SQLite (development):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://username:password@localhost:5432/artbox"
# For SQLite on a persistent disk (e.g. Railway volume at /data):
# DATABASE_URL="file:/data/prod.db"

# Encryption key for sensitive data (32-byte hex string)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-32-byte-hex-string-here"

# Session secret for cookie signing
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"

# Folder for uploaded images. Leave unset locally (uses public/uploads).
# In production point it at a persistent disk, e.g.:
# UPLOAD_DIR=/data/uploads

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Note: Stripe keys are stored encrypted in the database, not here

# Google OAuth (for Google Photos integration)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
